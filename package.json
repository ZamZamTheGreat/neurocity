{
  "name": "neurocity",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/check-runtime-security.mjs && vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:security": "node scripts/run-security-tests.mjs",
    "test:identity": "tsc --target ES2017 --module esnext --moduleResolution bundler --skipLibCheck --strict --outDir .identity-test-dist --rootDir lib/neuroedge lib/neuroedge/uuid-v7.ts lib/neuroedge/current-actor.ts && node --test tests/neuroedge-identity.test.mjs",
    "test:all": "npm test && npm run test:integration",
    "test:load": "node scripts/load-test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:migrate": "node scripts/migrate.mjs",
    "db:grant-runtime": "node scripts/grant-runtime-db-role.mjs",
    "db:verify-runtime": "node scripts/verify-runtime-db-role.mjs",
    "db:verify-restore": "node scripts/verify-restored-database.mjs"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.15.5",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "0.45.2",
    "jose": "^6.1.3",
    "nodemailer": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
