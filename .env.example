DATABASE_URL=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
SESSION_SECRET=
ADMIN_EMAIL=sergejwitbooi@gmail.com
# Base32 secret shared with the administrator's authenticator app.
ADMIN_MFA_SECRET=
PUBLIC_SITE_URL=https://neurocity-fhl1.onrender.com
SECURITY_ALLOWED_ORIGINS=
# Set only after verifying the ingress overwrites this header.
TRUSTED_CLIENT_IP_HEADER=

# Cloudflare Turnstile. The site key is public; keep the secret server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Selma visual catalogue search. The model must support image input.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_CONCIERGE_MODEL=gpt-5.4-mini

# Gmail SMTP: use a Google App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NeuroCity <notifications@example.com>

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# Optional private clamd INSTREAM service. Raster images can be safely decoded
# and re-encoded without it; document uploads remain unavailable until it works.
# Set required to make the scanner mandatory for images too.
CLAMAV_HOST=
CLAMAV_PORT=3310
UPLOAD_MALWARE_SCAN_MODE=images_optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used for the OAuth callback, e.g. https://neurocity-fhl1.onrender.com
PUBLIC_APP_URL=

# Optional WhatsApp Business Cloud API order updates. The approved template
# body must accept: order reference, store name, status and note.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v22.0
