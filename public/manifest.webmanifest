{
  "id": "/",
  "name": "NeuroCity — Namibia's connected shopping network",
  "short_name": "NeuroCity",
  "description": "Explore Namibia's marketplace, digital malls and local stores in one connected network.",
  "lang": "en-NA",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#080808",
  "theme_color": "#080808",
  "categories": ["shopping", "business", "lifestyle"],
  "icons": [
    { "src": "/icons/neurocity-malls-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/neurocity-malls-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/neurocity-malls-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Browse stores", "short_name": "Stores", "url": "/marketplace#stores", "icons": [{ "src": "/icons/neurocity-malls-192.png", "sizes": "192x192" }] },
    { "name": "My account", "short_name": "Account", "url": "/account", "icons": [{ "src": "/icons/neurocity-malls-192.png", "sizes": "192x192" }] },
    { "name": "Merchant dashboard", "short_name": "Dashboard", "url": "/dashboard", "icons": [{ "src": "/icons/neurocity-malls-192.png", "sizes": "192x192" }] }
  ]
}
